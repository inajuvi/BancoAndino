# Copia este archivo como .env y completa la API key. Nunca subas .env al repositorio.
ANTHROPIC_API_KEY=
# Modelo de los agentes (claude-haiku-5-5 es el de la demo; claude-opus-5-5 también funciona)
MODELO=claude-haiku-5-5
# El servidor solo escucha en la máquina local
HOST=127.0.0.1
PORT=4000
# Solicitudes por minuto (cada una hace 3 llamadas al modelo)
RATE_LIMIT_MAX=20
