# Copia este archivo a .env y ajusta los valores. Nunca subas .env al repositorio.
PORT=3000
# Mínimo 16 caracteres. En producción usa un secreto generado y guardado en Secrets Manager.
JWT_SECRET=cambia-este-secreto-de-desarrollo
# Límite de caracteres del texto del cliente (parámetro configurable, CA-4).
MAX_TEXT_LENGTH=5000
# Origen permitido por CORS (el front-end de la consola).
CORS_ORIGIN=http://localhost:5173
# Peticiones por minuto y por IP al endpoint /casos.
RATE_LIMIT_MAX=60
